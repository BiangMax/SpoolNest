{
  "name": "spoolnest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "start": "node --import tsx apps/server/src/index.ts",
    "test": "vitest run",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "restore": "node --import tsx scripts/restore.ts",
    "format": "prettier --write apps packages scripts tests docs *.json *.ts *.md .github/workflows/*.yml",
    "format:check": "prettier --check apps packages scripts tests docs *.json *.ts *.md .github/workflows/*.yml",
    "build:cloudflare": "npm run build && node scripts/build-cloudflare.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.11",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.3.0",
    "fastify": "^5.6.2",
    "lucide-vue-next": "^0.468.0",
    "mqtt-packet": "^9.0.2",
    "pinia": "^3.0.4",
    "reka-ui": "^2.6.0",
    "tsx": "^4.20.6",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "yauzl": "^3.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-vue": "^6.0.2",
    "concurrently": "^9.2.1",
    "esbuild": "0.28.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9",
    "vue-tsc": "^3.1.4"
  },
  "license": "MIT",
  "description": "Local-first 3D printing filament inventory with explicit print review and auditable stock movements."
}
