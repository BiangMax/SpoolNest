HOST=127.0.0.1
PORT=4310
DATABASE_PATH=./data/spoolnest.db
# Required when HOST is not loopback. Use a long random secret; never commit .env.
ADMIN_TOKEN=
# Experimental community integration. Disabled unless you deliberately opt in.
BAMBU_EXPERIMENTAL=false
BAMBU_REGION=cn
# Token stays in process environment, never the database or logs.
BAMBU_ACCESS_TOKEN=
# Required for a custom hostname / HTTPS reverse proxy; exact origin, no trailing slash.
# PUBLIC_ORIGIN=https://spoolnest.example.com
